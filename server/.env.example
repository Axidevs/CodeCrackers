# CURA Backend Environment Variables Example
PORT=5001
NODE_ENV=development
ML_SERVICE_URL=http://localhost:8000/predict
ML_SERVICE_TIMEOUT_MS=2000
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108
BOOKINGS_AFFECT_AVAILABILITY=true

# Use SMS_PROVIDER=twilio and provide all three Twilio Verify values for SMS delivery.
# SMS_PROVIDER=development is allowed only when NODE_ENV=development; it returns
# a random, one-time development code in the API response and does not send SMS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SMS_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_SECONDS=900
OTP_VERIFY_ATTEMPT_LIMIT=5
AUTH_SESSION_TTL_DAYS=30
AUTH_STORE_PATH=src/data/auth_store.json
